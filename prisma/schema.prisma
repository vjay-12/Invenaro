generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  password_hash        String
  name                 String
  role                 UserRole  @default(STAFF)
  assigned_godown_id   String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  must_change_password Boolean   @default(false)
  sessions             Session[]
  assigned_godown      Godown?   @relation(fields: [assigned_godown_id], references: [id])

  @@map("users")
}

model Session {
  id         String   @id @default(uuid())
  token_hash String   @unique
  user_id    String
  expires_at DateTime
  ip_address String?
  user_agent String?
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token_hash])
  @@map("sessions")
}

model LoginAttempt {
  id           String   @id @default(uuid())
  email        String
  ip_address   String?
  successful   Boolean  @default(false)
  attempted_at DateTime @default(now())

  @@index([email, attempted_at])
  @@index([ip_address, attempted_at])
  @@map("login_attempts")
}

model CompanySettings {
  id           String   @id @default("default_settings")
  company_name String   @default("My Business")
  legal_name   String?
  phone        String?
  email        String?
  address      String?
  state_code   String?
  gstin        String?
  enable_gst   Boolean  @default(false)
  logo_data    String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("company_settings")
}

model LicenseCache {
  id            String   @id @default("active_license")
  plan          String   @default("basic")
  fetchedAt     DateTime @default(now())
  lastAttemptAt DateTime @default(now())
  lastError     String?
  modules       Json
  status        String   @default("unlicensed")
  token         String
  tokenExp      DateTime

  @@map("license_cache")
}

model Godown {
  id              String            @id @default(uuid())
  name            String
  code            String            @unique
  address         String?
  state_code      String?
  gstin           String?
  is_default      Boolean           @default(false)
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  invoices        Invoice[]
  purchase_orders PurchaseOrder[]
  sales_orders    SalesOrder[]
  adjustments     StockAdjustment[]
  stock_balances  StockBalance[]
  stock_movements StockMovement[]
  transfers_in    StockTransfer[]   @relation("DestGodown")
  transfers_out   StockTransfer[]   @relation("SourceGodown")
  users           User[]

  @@map("godowns")
}

model ProductCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  created_at  DateTime  @default(now())
  products    Product[]

  @@map("product_categories")
}

model Product {
  id               String                @id @default(uuid())
  sku              String                @unique
  name             String
  description      String?
  category_id      String?
  unit             String                @default("PCS")
  sale_price       Decimal               @default(0) @db.Decimal(12, 2)
  purchase_price   Decimal               @default(0) @db.Decimal(12, 2)
  hsn_code         String?
  tax_rate         Decimal               @default(0) @db.Decimal(5, 2)
  min_stock_level  Decimal               @default(0) @db.Decimal(12, 2)
  is_active        Boolean               @default(true)
  created_at       DateTime              @default(now())
  updated_at       DateTime              @updatedAt
  category         ProductCategory?      @relation(fields: [category_id], references: [id])
  purchase_items   PurchaseOrderItem[]
  sales_items      SalesOrderItem[]
  adjustment_items StockAdjustmentItem[]
  stock_balances   StockBalance[]
  stock_movements  StockMovement[]
  transfer_items   StockTransferItem[]

  @@map("products")
}

model StockBalance {
  id               String   @id @default(uuid())
  product_id       String
  godown_id        String
  current_quantity Decimal  @default(0) @db.Decimal(12, 2)
  avg_cost         Decimal  @default(0) @db.Decimal(12, 2)
  updated_at       DateTime @updatedAt
  godown           Godown   @relation(fields: [godown_id], references: [id], onDelete: Cascade)
  product          Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, godown_id])
  @@index([godown_id])
  @@map("stock_balances")
}

model StockMovement {
  id             String       @id @default(uuid())
  movement_type  MovementType
  product_id     String
  godown_id      String
  quantity       Decimal      @db.Decimal(12, 2)
  unit_cost      Decimal      @default(0) @db.Decimal(12, 2)
  balance_after  Decimal      @db.Decimal(12, 2)
  reference_type String
  reference_id   String
  notes          String?
  created_at     DateTime     @default(now())
  created_by     String?
  godown         Godown       @relation(fields: [godown_id], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id, godown_id])
  @@index([movement_type])
  @@index([reference_id])
  @@map("stock_movements")
}

model Customer {
  id           String       @id @default(uuid())
  name         String
  phone        String?
  email        String?
  address      String?
  state_code   String?
  gstin        String?
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt
  invoices             Invoice[]
  payments             Payment[]
  sales_orders         SalesOrder[]
  measurement_profiles CustomerMeasurementProfile[]

  @@map("customers")
}

model Supplier {
  id              String          @id @default(uuid())
  name            String
  contact_person  String?
  category        String?
  vendor_type     String?
  notes           String?
  phone           String?
  email           String?
  address         String?
  city            String?
  state           String?
  state_code      String?
  gstin           String?
  opening_balance Decimal         @default(0) @db.Decimal(12, 2)
  is_active       Boolean         @default(true)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  payments        Payment[]
  purchase_orders PurchaseOrder[]

  @@map("suppliers")
}

model SalesOrder {
  id               String           @id @default(uuid())
  order_number     String           @unique
  customer_id      String?
  customer_name    String
  customer_phone   String?
  customer_address String?
  customer_gstin   String?
  godown_id        String
  order_date       DateTime         @default(now())
  status           OrderStatus      @default(CONFIRMED)
  subtotal         Decimal          @default(0) @db.Decimal(12, 2)
  tax_total        Decimal          @default(0) @db.Decimal(12, 2)
  discount_total   Decimal          @default(0) @db.Decimal(12, 2)
  grand_total      Decimal          @default(0) @db.Decimal(12, 2)
  notes            String?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  created_by       String?
  invoices         Invoice[]
  items            SalesOrderItem[]
  customer         Customer?        @relation(fields: [customer_id], references: [id])
  godown           Godown           @relation(fields: [godown_id], references: [id])

  @@index([customer_id])
  @@index([godown_id])
  @@map("sales_orders")
}

model SalesOrderItem {
  id             String     @id @default(uuid())
  sales_order_id String
  product_id     String
  quantity       Decimal    @db.Decimal(12, 2)
  unit_price     Decimal    @db.Decimal(12, 2)
  discount       Decimal    @default(0) @db.Decimal(12, 2)
  tax_rate       Decimal    @default(0) @db.Decimal(5, 2)
  tax_amount     Decimal    @default(0) @db.Decimal(12, 2)
  total          Decimal    @db.Decimal(12, 2)
  product        Product    @relation(fields: [product_id], references: [id])
  sales_order    SalesOrder @relation(fields: [sales_order_id], references: [id], onDelete: Cascade)

  @@map("sales_order_items")
}

model PurchaseOrder {
  id               String              @id @default(uuid())
  po_number        String              @unique
  supplier_id      String?
  supplier_name    String
  supplier_phone   String?
  supplier_address String?
  supplier_gstin   String?
  godown_id        String
  order_date       DateTime            @default(now())
  expected_date    DateTime?
  status           POStatus            @default(ORDERED)
  subtotal         Decimal             @default(0) @db.Decimal(12, 2)
  tax_total        Decimal             @default(0) @db.Decimal(12, 2)
  grand_total      Decimal             @default(0) @db.Decimal(12, 2)
  notes            String?
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt
  created_by       String?
  items            PurchaseOrderItem[]
  godown           Godown              @relation(fields: [godown_id], references: [id])
  supplier         Supplier?           @relation(fields: [supplier_id], references: [id])

  @@index([supplier_id])
  @@index([godown_id])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String        @id @default(uuid())
  purchase_order_id String
  product_id        String
  quantity          Decimal       @db.Decimal(12, 2)
  unit_cost         Decimal       @db.Decimal(12, 2)
  tax_rate          Decimal       @default(0) @db.Decimal(5, 2)
  tax_amount        Decimal       @default(0) @db.Decimal(12, 2)
  total             Decimal       @db.Decimal(12, 2)
  product           Product       @relation(fields: [product_id], references: [id])
  purchase_order    PurchaseOrder @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

model StockTransfer {
  id                    String              @id @default(uuid())
  transfer_number       String              @unique
  source_godown_id      String
  destination_godown_id String
  status                TransferStatus      @default(DRAFT)
  doc_type              String              @default("CHALLAN")
  eway_bill_number      String?
  vehicle_number        String?
  transporter_name      String?
  distance_km           Decimal?            @db.Decimal(8, 2)
  notes                 String?
  created_at            DateTime            @default(now())
  updated_at            DateTime            @updatedAt
  created_by            String?
  items                 StockTransferItem[]
  destination_godown    Godown              @relation("DestGodown", fields: [destination_godown_id], references: [id])
  source_godown         Godown              @relation("SourceGodown", fields: [source_godown_id], references: [id])

  @@map("stock_transfers")
}

model StockTransferItem {
  id          String        @id @default(uuid())
  transfer_id String
  product_id  String
  quantity    Decimal       @db.Decimal(12, 2)
  unit_cost   Decimal       @default(0) @db.Decimal(12, 2)
  product     Product       @relation(fields: [product_id], references: [id])
  transfer    StockTransfer @relation(fields: [transfer_id], references: [id], onDelete: Cascade)

  @@map("stock_transfer_items")
}

model StockAdjustment {
  id                String                @id @default(uuid())
  adjustment_number String                @unique
  godown_id         String
  reason            String
  status            String                @default("APPLIED")
  notes             String?
  created_at        DateTime              @default(now())
  created_by        String?
  items             StockAdjustmentItem[]
  godown            Godown                @relation(fields: [godown_id], references: [id])

  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id            String          @id @default(uuid())
  adjustment_id String
  product_id    String
  system_qty    Decimal         @db.Decimal(12, 2)
  counted_qty   Decimal         @db.Decimal(12, 2)
  diff_qty      Decimal         @db.Decimal(12, 2)
  unit_cost     Decimal         @default(0) @db.Decimal(12, 2)
  adjustment    StockAdjustment @relation(fields: [adjustment_id], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [product_id], references: [id])

  @@map("stock_adjustment_items")
}

model Invoice {
  id                 String      @id @default(uuid())
  invoice_number     String      @unique
  invoice_type       String      @default("TAX_INVOICE")
  reference_order_id String?
  customer_id        String?
  godown_id          String
  invoice_date       DateTime    @default(now())
  due_date           DateTime?
  status             String      @default("UNPAID")
  subtotal           Decimal     @default(0) @db.Decimal(12, 2)
  tax_total          Decimal     @default(0) @db.Decimal(12, 2)
  grand_total        Decimal     @default(0) @db.Decimal(12, 2)
  paid_amount        Decimal     @default(0) @db.Decimal(12, 2)
  balance_amount     Decimal     @default(0) @db.Decimal(12, 2)
  created_at         DateTime    @default(now())
  customer           Customer?   @relation(fields: [customer_id], references: [id])
  godown             Godown      @relation(fields: [godown_id], references: [id])
  sales_order        SalesOrder? @relation(fields: [reference_order_id], references: [id])
  payments           Payment[]

  @@map("invoices")
}

model Payment {
  id               String    @id @default(uuid())
  payment_number   String    @unique
  invoice_id       String?
  customer_id      String?
  supplier_id      String?
  payment_date     DateTime  @default(now())
  amount           Decimal   @db.Decimal(12, 2)
  payment_mode     String    @default("CASH")
  reference_number String?
  notes            String?
  created_at       DateTime  @default(now())
  customer         Customer? @relation(fields: [customer_id], references: [id])
  invoice          Invoice?  @relation(fields: [invoice_id], references: [id])
  supplier         Supplier? @relation(fields: [supplier_id], references: [id])

  @@map("payments")
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
}

enum MovementType {
  PURCHASE_RECEIPT
  SALES_DELIVERY
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_ADD
  ADJUSTMENT_REDUCE
  RETURN_IN
  RETURN_OUT
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum POStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model MeasurementTemplate {
  id          String                      @id @default(uuid())
  name        String
  code        String                      @unique
  description String?
  category    String                      @default("WOMEN")
  is_default  Boolean                     @default(false)
  is_active   Boolean                     @default(true)
  created_at  DateTime                    @default(now())
  updated_at  DateTime                    @updatedAt

  fields      MeasurementTemplateField[]
  profiles    CustomerMeasurementProfile[]

  @@map("measurement_templates")
}

model MeasurementTemplateField {
  id            String                    @id @default(uuid())
  template_id   String
  field_key     String
  field_name    String
  field_type    String                    @default("number")
  default_unit  String                    @default("in")
  display_order Int                       @default(0)
  is_required   Boolean                   @default(false)
  is_active     Boolean                   @default(true)
  created_at    DateTime                  @default(now())
  updated_at    DateTime                  @updatedAt

  template      MeasurementTemplate       @relation(fields: [template_id], references: [id], onDelete: Cascade)
  values        CustomerMeasurementValue[]

  @@unique([template_id, field_key])
  @@index([template_id, display_order])
  @@map("measurement_template_fields")
}

model CustomerMeasurementProfile {
  id            String                      @id @default(uuid())
  customer_id   String
  template_id   String
  profile_name  String
  notes         String?
  is_active     Boolean                     @default(true)
  created_at    DateTime                    @default(now())
  updated_at    DateTime                    @updatedAt

  customer      Customer                    @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  template      MeasurementTemplate         @relation(fields: [template_id], references: [id], onDelete: Restrict)
  versions      CustomerMeasurementVersion[]

  @@index([customer_id])
  @@index([template_id])
  @@map("customer_measurement_profiles")
}

model CustomerMeasurementVersion {
  id             String                      @id @default(uuid())
  profile_id     String
  version_number Int                         @default(1)
  measured_at    DateTime                    @default(now())
  measured_by    String?
  notes          String?
  is_current     Boolean                     @default(true)
  created_at     DateTime                    @default(now())

  profile        CustomerMeasurementProfile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  values         CustomerMeasurementValue[]

  @@index([profile_id, is_current])
  @@index([profile_id, version_number])
  @@map("customer_measurement_versions")
}

model CustomerMeasurementValue {
  id            String                     @id @default(uuid())
  version_id    String
  field_id      String
  numeric_value Decimal?                   @db.Decimal(8, 2)
  text_value    String?
  unit          String                     @default("in")
  notes         String?
  created_at    DateTime                   @default(now())

  version       CustomerMeasurementVersion @relation(fields: [version_id], references: [id], onDelete: Cascade)
  field         MeasurementTemplateField   @relation(fields: [field_id], references: [id], onDelete: Cascade)

  @@unique([version_id, field_id])
  @@index([version_id])
  @@index([field_id])
  @@map("customer_measurement_values")
}
