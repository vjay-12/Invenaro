{
  "name": "invenaro",
  "version": "1.0.0",
  "private": true,
  "description": "Invenaro - Dedicated deployment inventory & stock control platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev --workspace=@invenaro/api\" \"npm run dev --workspace=@invenaro/web\"",
    "dev:api": "npm run dev --workspace=@invenaro/api",
    "dev:web": "npm run dev --workspace=@invenaro/web",
    "build": "npm run build --workspaces --if-present",
    "test": "tsx --test apps/api/src/test_invenaro.ts apps/api/src/test_ledger.ts apps/api/src/test_auth_hardening.ts apps/api/src/test_license_integration.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "admin:create": "tsx apps/api/src/scripts/createAdmin.ts",
    "seed:dev": "tsx prisma/dev-seed.ts"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prisma": "^6.4.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@neon/config": "^1.7.2",
    "@neon/env": "^1.4.3"
  }
}
