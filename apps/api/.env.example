# ==============================================================================
# INVENARO API ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database (Neon PostgreSQL) - REQUIRED
DATABASE_URL="postgresql://[user]:[password]@[endpoint-pooler].[region].neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://[user]:[password]@[endpoint].[region].neon.tech/neondb?sslmode=require"

# Server & Auth - REQUIRED
NODE_ENV="production"
PORT=3001
SESSION_SECRET="your-secure-random-session-secret-here"

# Licensing (invenaro-control) - REQUIRED FOR PRODUCTION
LICENSE_KEY="INV-XXXX-XXXX-XXXX-XXXX-XXXX"
LICENSE_API_URL="https://invenaro-control.vercel.app"
LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
APP_DOMAIN="localhost"
CRON_SECRET="your-cron-secret-token-here"
LICENSE_ENFORCEMENT="on"
LICENSE_OFFLINE_GRACE_DAYS="7"
