# ==============================================================================
# INVENARO ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Neon PostgreSQL) - REQUIRED
# ------------------------------------------------------------------------------
# Pooled connection string for serverless API runtime (PgBouncer / Neon connection pooler)
DATABASE_URL="postgresql://[user]:[password]@[endpoint-pooler].[region].neon.tech/neondb?sslmode=require"

# Direct non-pooled connection string used exclusively by Prisma migrations & db push
DIRECT_URL="postgresql://[user]:[password]@[endpoint].[region].neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. SERVER & AUTHENTICATION - REQUIRED
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV="development"

# Secure random secret for session encryption (e.g. openssl rand -hex 32)
SESSION_SECRET="your-secure-random-session-secret-here"

# ------------------------------------------------------------------------------
# 3. LICENSE INTEGRATION (invenaro-control) - REQUIRED FOR PRODUCTION
# ------------------------------------------------------------------------------
# Customer deployment license key (INV-XXXX-XXXX-XXXX-XXXX-XXXX)
LICENSE_KEY="INV-DEV0-0000-0000-0000-0000"

# Central control API endpoint for verification
LICENSE_API_URL="https://control.invenaro.com"

# Public key for EdDSA (Ed25519) signature verification (SPKI PEM or base64 SPKI PEM)
LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEA...\n-----END PUBLIC KEY-----"

# Optional: Public JWKS json for key rotation (alternative to LICENSE_PUBLIC_KEY)
# LICENSE_PUBLIC_JWKS='{"keys":[{"kty":"OKP","crv":"Ed25519","kid":"key-1","x":"..."}]}'

# Deployment domain expected in signed token (e.g. customer.invenaro.app)
APP_DOMAIN="localhost"

# App version sent to license service
APP_VERSION="1.0.0"

# Secret protecting the /api/cron/license-refresh endpoint from unauthorized requests
CRON_SECRET="your-cron-secret-token-here"

# Number of days to continue operating with last verified token when license service is unreachable (default: 7)
LICENSE_OFFLINE_GRACE_DAYS="7"

# Development bypass: set to 'off' ONLY during local development (ignored in production)
LICENSE_ENFORCEMENT="on"

# ------------------------------------------------------------------------------
# 4. THIRD-PARTY SERVICES (Optional)
# ------------------------------------------------------------------------------
# Email delivery via Resend
RESEND_API_KEY=""

# SMS / OTP delivery via MSG91
MSG91_API_KEY=""

# Error tracking via Sentry
SENTRY_DSN=""
