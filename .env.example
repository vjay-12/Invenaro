# ==============================================================================
# INVENARO ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Neon PostgreSQL) - REQUIRED
# ------------------------------------------------------------------------------
# Pooled connection string for serverless API runtime (uses PgBouncer / Neon connection pooler)
DATABASE_URL="postgresql://[user]:[password]@[endpoint-pooler].[region].neon.tech/neondb?sslmode=require"

# Direct non-pooled connection string used exclusively by Prisma migrations & db push
DIRECT_URL="postgresql://[user]:[password]@[endpoint].[region].neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. SERVER & AUTHENTICATION - REQUIRED
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV="development"

# Secure random secret for session encryption (e.g. openssl rand -hex 32)
SESSION_SECRET="invenaro-super-secret-session-key-change-in-production"

# ------------------------------------------------------------------------------
# 3. TENANT & LICENSE ENTITLEMENTS
# ------------------------------------------------------------------------------
CUSTOMER_ID="cust_local_dev"
CUSTOMER_DOMAIN="localhost"

# Active tier for local development: 'basic' | 'business' | 'enterprise'
DEFAULT_PLAN="business"

# Production License Keys (signed token verified against central Invenaro API)
LICENSE_KEY="invenaro_lic_dev_placeholder"
LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ------------------------------------------------------------------------------
# 4. THIRD-PARTY SERVICES (Optional for local testing; required for production)
# ------------------------------------------------------------------------------
# Email delivery via Resend
RESEND_API_KEY=""

# SMS / OTP delivery for India via MSG91
MSG91_API_KEY=""

# Error tracking via Sentry
SENTRY_DSN=""
